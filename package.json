{
	"name": "@matrix-nebu/monorepo",
	"version": "1.0.0",
	"private": true,
	"description": "Root configuration for the pnpm workspace",
	"scripts": {
		"build": "tsc -b",
		"check": "tsc -b --pretty",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"docs": "typedoc --options ./typedoc.config.mjs",
		"test": "vitest run --typecheck",
		"test:watch": "vitest watch --typecheck"
	},
	"license": "MIT",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.22.0",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"prettier": "^3.9.6",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"type": "module"
}
